---
import type { InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import { getTechIcon } from "@/lib/icons";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content: ToolContent } = await entry.render();
---

<Layout title={entry.data.title} description={entry.data.tagline ?? entry.data.title}>
  <Header />

  <main class="mx-auto flex max-w-7xl flex-col gap-10">
    <h1 class="text-6xl font-medium text-gray-700">{entry.data.title}</h1>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-[3fr_1fr]">
      <div class="md-tool-body">
        <ToolContent />
      </div>

      <div class="flex flex-col gap-10 text-[15px]">
        {
          entry.data.tech && entry.data.tech.length > 0 ? (
            <div>
              <h4 class="pb-1.5 text-gray-400">Technologies</h4>
              <ul class="flex gap-3 text-gray-700/90">
                {entry.data.tech.map((tech) => (
                  <li class="h-8 w-8 overflow-hidden" title={tech}>
                    <Icon name={getTechIcon(tech)} />
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        <a
          class="md-tool-website inline-flex items-center gap-2 text-[18px] font-semibold text-blue-500"
          target="_blank"
          rel="noopener noreferrer"
          href={entry.data.website}
        >
          Visit project
          <svg
            class="inline-block h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M13.3 17.275q-.3-.3-.288-.725t.313-.725L16.15 13H5q-.425 0-.713-.288T4 12q0-.425.288-.713T5 11h11.15L13.3 8.15q-.3-.3-.3-.713t.3-.712q.3-.3.713-.3t.712.3L19.3 11.3q.15.15.213.325t.062.375q0 .2-.063.375t-.212.325l-4.6 4.6q-.275.275-.687.275t-.713-.3Z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  .md-tool-body {
    @apply text-gray-700;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.5em;
    color: #3b4c56;
    margin-bottom: 40px;
    margin-top: 0;

    a {
      @apply text-blue-500;
    }
  }
</style>

<style>
  @reference "../../styles/global.css";

  .md-tool-website:hover > svg {
    @apply translate-x-1 scale-105 transition;
  }
</style>
